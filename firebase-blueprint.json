{
  "entities": {
    "AcademySettings": {
      "title": "AcademySettings",
      "description": "Publicly readable payment, contact, and pricing configuration managed by the admin.",
      "type": "object",
      "properties": {
        "academyNameEn": { "type": "string", "minLength": 2, "maxLength": 100 },
        "academyNameAr": { "type": "string", "minLength": 2, "maxLength": 100 },
        "logoDataUrl": { "type": "string", "maxLength": 150000 },
        "instapayHandle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "instapayUrl": { "type": "string", "maxLength": 300 },
        "whatsappNumber": { "type": "string", "minLength": 6, "maxLength": 25 },
        "whiteLabelPriceEgp": { "type": "number" },
        "aiCertificatePriceEgp": { "type": "number" },
        "quizTermPriceEgp": { "type": "number" },
        "termPromoEnabled": { "type": "boolean" },
        "termPromoTitleAr": { "type": "string", "maxLength": 140 },
        "termPromoTitleEn": { "type": "string", "maxLength": 140 },
        "termPromoSubtitleAr": { "type": "string", "maxLength": 240 },
        "termPromoSubtitleEn": { "type": "string", "maxLength": 240 },
        "termPromoDurationDays": { "type": "number" },
        "seeded": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "academyNameEn",
        "academyNameAr",
        "instapayHandle",
        "whatsappNumber",
        "whiteLabelPriceEgp",
        "aiCertificatePriceEgp",
        "seeded",
        "updatedAt"
      ]
    },
    "GradeResource": {
      "title": "GradeResource",
      "description": "Grade-level English lesson prep, exam, worksheet, or interactive/printable activity.",
      "type": "object",
      "properties": {
        "gradeId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "category": { "type": "string", "enum": ["prep", "exam", "worksheet", "activity"] },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "descriptionEn": { "type": "string", "maxLength": 1200 },
        "descriptionAr": { "type": "string", "maxLength": 1200 },
        "isInteractive": { "type": "boolean" },
        "isPaid": { "type": "boolean" },
        "priceEgp": { "type": "number" },
        "allowWhiteLabel": { "type": "boolean" },
        "contentText": { "type": "string", "maxLength": 25000 },
        "fileName": { "type": "string", "maxLength": 180 },
        "fileDataUrl": { "type": "string", "maxLength": 920000 },
        "externalUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https://.*" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "gradeId",
        "category",
        "titleEn",
        "titleAr",
        "descriptionEn",
        "descriptionAr",
        "isInteractive",
        "isPaid",
        "priceEgp",
        "allowWhiteLabel",
        "contentText",
        "authorUid",
        "createdAt"
      ]
    },
    "StoryItem": {
      "title": "StoryItem",
      "description": "Paid or featured English educational storybook uploaded by admin.",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "levelLabel": { "type": "string", "minLength": 2, "maxLength": 60 },
        "summaryEn": { "type": "string", "maxLength": 1000 },
        "summaryAr": { "type": "string", "maxLength": 1000 },
        "previewExcerpt": { "type": "string", "maxLength": 2000 },
        "coverUrl": { "type": "string", "maxLength": 120000 },
        "isPaid": { "type": "boolean" },
        "priceEgp": { "type": "number" },
        "fileName": { "type": "string", "maxLength": 180 },
        "fileDataUrl": { "type": "string", "maxLength": 920000 },
        "externalUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https://.*" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleEn",
        "titleAr",
        "levelLabel",
        "summaryEn",
        "summaryAr",
        "previewExcerpt",
        "coverUrl",
        "isPaid",
        "priceEgp",
        "authorUid",
        "createdAt"
      ]
    },
    "OfficialPaper": {
      "title": "OfficialPaper",
      "description": "Official school forms, records, and templates.",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "categoryEn": { "type": "string", "minLength": 2, "maxLength": 80 },
        "categoryAr": { "type": "string", "minLength": 2, "maxLength": 80 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "contentText": { "type": "string", "maxLength": 20000 },
        "coverUrl": { "type": "string", "maxLength": 120000 },
        "fileName": { "type": "string", "maxLength": 180 },
        "fileDataUrl": { "type": "string", "maxLength": 920000 },
        "externalUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https://.*" },
        "isPaid": { "type": "boolean" },
        "priceEgp": { "type": "number" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleEn",
        "titleAr",
        "categoryEn",
        "categoryAr",
        "descriptionEn",
        "descriptionAr",
        "contentText",
        "isPaid",
        "priceEgp",
        "authorUid",
        "createdAt"
      ]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Simple announcement and news item published by admin.",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "bodyEn": { "type": "string", "maxLength": 2500 },
        "bodyAr": { "type": "string", "maxLength": 2500 },
        "tagEn": { "type": "string", "maxLength": 60 },
        "tagAr": { "type": "string", "maxLength": 60 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleEn",
        "titleAr",
        "bodyEn",
        "bodyAr",
        "tagEn",
        "tagAr",
        "authorUid",
        "createdAt"
      ]
    },
    "TeacherPrep": {
      "title": "TeacherPrep",
      "description": "Teacher-authored English lesson preparation with shareable Facebook link.",
      "type": "object",
      "properties": {
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "schoolOrCenter": { "type": "string", "maxLength": 120 },
        "gradeLabel": { "type": "string", "minLength": 2, "maxLength": 60 },
        "unitTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "lessonTitle": { "type": "string", "minLength": 2, "maxLength": 160 },
        "objectives": { "type": "string", "maxLength": 2500 },
        "warmUp": { "type": "string", "maxLength": 1500 },
        "vocabulary": { "type": "string", "maxLength": 1500 },
        "procedures": { "type": "string", "maxLength": 5000 },
        "assessment": { "type": "string", "maxLength": 2000 },
        "homework": { "type": "string", "maxLength": 1500 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "teacherName",
        "gradeLabel",
        "unitTitle",
        "lessonTitle",
        "objectives",
        "procedures",
        "ownerUid",
        "createdAt"
      ]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "InstaPay to WhatsApp order intent logged by a signed-in user.",
      "type": "object",
      "properties": {
        "itemType": { "type": "string", "enum": ["activity", "worksheet", "worksheet_pack", "exam", "story", "whitelabel", "certificate", "paper", "quiz_term"] },
        "itemTitle": { "type": "string", "minLength": 2, "maxLength": 180 },
        "amountEgp": { "type": "number" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customBrandingName": { "type": "string", "maxLength": 120 },
        "instapayRef": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending_whatsapp", "confirmed"] },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "itemType",
        "itemTitle",
        "amountEgp",
        "customerName",
        "status",
        "ownerUid",
        "createdAt"
      ]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Explicit admin membership record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "WorksheetPack": {
      "title": "WorksheetPack",
      "description": "Numbered worksheet and printable activity folder organized by age level and learning track.",
      "type": "object",
      "properties": {
        "packNumber": { "type": "number" },
        "levelId": { "type": "string", "enum": ["age_3_5", "age_5_7", "primary", "prep_sec"] },
        "track": { "type": "string", "enum": ["arabic_letters", "english_letters", "numbers", "writing_skills", "general"] },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "descriptionEn": { "type": "string", "maxLength": 1200 },
        "descriptionAr": { "type": "string", "maxLength": 1200 },
        "isPaid": { "type": "boolean" },
        "priceEgp": { "type": "number" },
        "allowWhiteLabel": { "type": "boolean" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "packNumber",
        "levelId",
        "track",
        "titleEn",
        "titleAr",
        "descriptionEn",
        "descriptionAr",
        "isPaid",
        "priceEgp",
        "allowWhiteLabel",
        "authorUid",
        "createdAt"
      ]
    },
    "WorksheetPackItem": {
      "title": "WorksheetPackItem",
      "description": "Individual printable worksheet or regular activity belonging to a numbered WorksheetPack.",
      "type": "object",
      "properties": {
        "packId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemOrder": { "type": "number" },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "kind": { "type": "string", "enum": ["worksheet", "activity"] },
        "isFreeSample": { "type": "boolean" },
        "contentText": { "type": "string", "maxLength": 25000 },
        "fileName": { "type": "string", "maxLength": 180 },
        "fileDataUrl": { "type": "string", "maxLength": 920000 },
        "externalUrl": { "type": "string", "minLength": 8, "maxLength": 500, "pattern": "^https://.*" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "packId",
        "itemOrder",
        "titleEn",
        "titleAr",
        "kind",
        "isFreeSample",
        "contentText",
        "authorUid",
        "createdAt"
      ]
    },
    "AffiliateCourse": {
      "title": "AffiliateCourse",
      "description": "Free-to-browse professional development courses for teachers using affiliate referral links.",
      "type": "object",
      "properties": {
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleAr": { "type": "string", "minLength": 2, "maxLength": 160 },
        "provider": { "type": "string", "minLength": 2, "maxLength": 80 },
        "track": { "type": "string", "enum": ["phonics", "methodology", "ai_teaching", "career"] },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "descriptionAr": { "type": "string", "maxLength": 1000 },
        "durationLabel": { "type": "string", "maxLength": 80 },
        "affiliateUrl": { "type": "string", "minLength": 8, "maxLength": 500 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleEn",
        "titleAr",
        "provider",
        "track",
        "descriptionEn",
        "descriptionAr",
        "durationLabel",
        "affiliateUrl",
        "authorUid",
        "createdAt"
      ]
    },
    "QuestionBankItem": {
      "title": "QuestionBankItem",
      "description": "Curated multiple-choice question managed by admin for teachers to pick into quizzes.",
      "type": "object",
      "properties": {
        "gradeId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "unitLabel": { "type": "string", "minLength": 2, "maxLength": 100 },
        "prompt": { "type": "string", "minLength": 3, "maxLength": 600 },
        "options": { "type": "array" },
        "correctIndex": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 500 },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "gradeId",
        "unitLabel",
        "prompt",
        "options",
        "correctIndex",
        "authorUid",
        "createdAt"
      ]
    },
    "TeacherQuiz": {
      "title": "TeacherQuiz",
      "description": "Quiz published by a teacher with a public shareable link for students.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "gradeLabel": { "type": "string", "minLength": 2, "maxLength": 80 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "schoolOrCenter": { "type": "string", "maxLength": 120 },
        "isTrial": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "timeLimitMinutes": { "type": "number" },
        "questions": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "gradeLabel",
        "teacherName",
        "isTrial",
        "isPublished",
        "timeLimitMinutes",
        "questions",
        "ownerUid",
        "createdAt"
      ]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz submission stored for teacher analytics dashboard.",
      "type": "object",
      "properties": {
        "quizId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quizOwnerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "studentGroup": { "type": "string", "maxLength": 80 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "answers": { "type": "array" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "quizId",
        "quizOwnerUid",
        "studentName",
        "score",
        "totalQuestions",
        "percentage",
        "answers",
        "submittedAt"
      ]
    },
    "TeacherSubscription": {
      "title": "TeacherSubscription",
      "description": "Term-level subscription granting teachers unlimited quiz creation and analytics.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "teacherEmail": { "type": "string", "maxLength": 160 },
        "termLabel": { "type": "string", "minLength": 2, "maxLength": 80 },
        "active": { "type": "boolean" },
        "durationDays": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "activatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "activatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "teacherName",
        "termLabel",
        "active",
        "activatedByUid",
        "activatedAt"
      ]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Single or multi-use redemption code created by admin to unlock paid resources, worksheet packs, or stories.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["resource", "pack", "story", "paper", "all_paid"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "note": { "type": "string", "maxLength": 160 },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" },
        "durationDays": { "type": "number" },
        "expiresAtMs": { "type": "number" },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "targetType",
        "targetId",
        "targetTitle",
        "maxUses",
        "usedCount",
        "active",
        "createdByUid",
        "createdAt"
      ]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Anonymous privacy-friendly visit, download, and learning interaction telemetry visible only to admin.",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "enum": ["page_visit", "file_download", "interactive_start", "code_redeem"] },
        "section": { "type": "string", "minLength": 1, "maxLength": 40 },
        "itemTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "itemId": { "type": "string", "maxLength": 128 },
        "deviceType": { "type": "string", "enum": ["mobile", "desktop"] },
        "lang": { "type": "string", "enum": ["ar", "en"] },
        "dayKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "eventType",
        "section",
        "itemTitle",
        "deviceType",
        "lang",
        "dayKey",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AcademySettings" },
      "description": "Academy global payment & pricing settings."
    },
    "/grades_resources/{resourceId}": {
      "schema": { "$ref": "#/entities/GradeResource" },
      "description": "Lesson preps, exams, and activities organized by grade."
    },
    "/worksheet_packs/{packId}": {
      "schema": { "$ref": "#/entities/WorksheetPack" },
      "description": "Numbered packs of worksheets & printable activities by age level and track."
    },
    "/worksheet_items/{itemId}": {
      "schema": { "$ref": "#/entities/WorksheetPackItem" },
      "description": "Individual sheets uploaded into a numbered worksheet pack."
    },
    "/affiliate_courses/{courseId}": {
      "schema": { "$ref": "#/entities/AffiliateCourse" },
      "description": "Free curated affiliate courses for English teachers."
    },
    "/question_bank/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionBankItem" },
      "description": "Curated question bank items managed by admin."
    },
    "/teacher_quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/TeacherQuiz" },
      "description": "Teacher-published quizzes accessible via shareable student link."
    },
    "/quiz_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Student quiz attempts visible strictly to quiz owner and admin."
    },
    "/teacher_subscriptions/{uid}": {
      "schema": { "$ref": "#/entities/TeacherSubscription" },
      "description": "Term quiz subscription status per teacher UID."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/StoryItem" },
      "description": "English educational stories managed by admin."
    },
    "/official_papers/{paperId}": {
      "schema": { "$ref": "#/entities/OfficialPaper" },
      "description": "Official school paperwork and templates."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsItem" },
      "description": "News and updates posted by admin."
    },
    "/teacher_preps/{prepId}": {
      "schema": { "$ref": "#/entities/TeacherPrep" },
      "description": "Teacher-created lesson preps shared via public link."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "InstaPay/WhatsApp order records."
    },
    "/activation_codes/{codeId}": {
      "schema": { "$ref": "#/entities/ActivationCode" },
      "description": "Admin-issued redemption codes for unlocking paid resources."
    },
    "/analytics_events/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Anonymous site visit and file download telemetry readable only by admin."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Admin role documents."
    }
  }
}
